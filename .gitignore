    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-color);
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
    }

    .game-container {
        background-color: var(--card-bg);
        border: 1px solid #2a2a35;
        border-radius: 16px;
        padding: 30px;
        width: 100%;
        max-width: 650px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
        position: relative;
        overflow: hidden;
    }

    .game-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple), var(--accent-pink));
    }

    h1 {
        font-size: 1.5rem;
        text-align: center;
        margin-bottom: 20px;
        color: #fff;
        letter-spacing: 1px;
    }

    .quiz-header {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
        color: #a0a0a0;
        margin-bottom: 15px;
        border-bottom: 1px solid #2a2a35;
        padding-bottom: 10px;
    }

    .question-text {
        font-size: 1.15rem;
        margin-bottom: 20px;
        line-height: 1.5;
        color: #f5f5f7;
    }

    .options-grid {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .option-btn {
        background-color: #21212b;
        color: var(--text-color);
        border: 1px solid #363646;
        padding: 14px 18px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 1rem;
        text-align: left;
        transition: all 0.2s ease;
        outline: none;
    }

    .option-btn:hover:not(:disabled) {
        background-color: #2e2e3d;
        border-color: var(--accent-blue);
        transform: translateX(4px);
    }

    .option-btn:focus {
        box-shadow: 0 0 0 3px rgba(58, 134, 255, 0.18);
        border-color: var(--accent-blue);
    }

    .option-btn[disabled] {
        opacity: 0.6;
        cursor: default;
        transform: none;
    }

    .option-btn.correct {
        background-color: rgba(56, 176, 0, 0.18);
        border-color: var(--success);
        color: #a7f3d0;
    }

    .option-btn.incorrect {
        background-color: rgba(217, 4, 41, 0.18);
        border-color: var(--error);
        color: #fecaca;
    }

    .feedback {
        margin-top: 20px;
        padding: 12px;
        border-radius: 8px;
        font-size: 0.95rem;
        display: none;
    }

    .next-btn {
        margin-top: 20px;
        background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
        color: white;
        border: none;
        padding: 12px;
        width: 100%;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        display: none;
        transition: opacity 0.2s;
    }

    .next-btn:hover {
        opacity: 0.9;
    }

    .score-screen {
        text-align: center;
        display: none;
    }

    .score-screen h2 {
        font-size: 2rem;
        margin-bottom: 15px;
        color: #fff;
    }

    .score-screen p {
        font-size: 1.1rem;
        margin-bottom: 25px;
        color: #b0b0bc;
    }

    .restart-btn {
        background: var(--accent-pink);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
    }
</style>
